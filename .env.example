# Bu dosyayı ".env" olarak kopyala ve anahtarını yaz.
# Anahtar al: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı:
# GEMINI_MODEL=gemini-flash-latest
# PORT=3000
# BATCH_SIZE=12
# Düşünme süresini kısıp hızlandırmak istersen (bazı modellerde desteklenmeyebilir):
# GEMINI_THINKING_BUDGET=0
